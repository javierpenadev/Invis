{
  "name": "invis",
  "version": "1.9.5",
  "description": "Invis — Tor + DNSCrypt + I2P для Windows (Electron UI, tray-приложение, системный DNS)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json",
    "watch": "tsc -p tsconfig.main.json --watch",
    "start": "npm run build && electron .",
    "fetch-bins": "node tools/fetch-bins.js",
    "make-icons": "node tools/make-icons.js",
    "check": "npm run build && node tools/dev-check.js",
    "dist": "npm run build && electron-builder --win",
    "checksums": "node tools/make-checksums.js",
    "dist:nsis": "npm run build && electron-builder --win nsis",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "license": "GPL-3.0",
  "build": {
    "appId": "local.invis",
    "productName": "Invis",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "preload.js",
      "index.html",
      "style.css",
      "app.css",
      "js/**",
      "assets/**",
      "THIRD-PARTY-LICENSES.md"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "win": {
      "icon": "assets/img/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3"
  }
}
